{"text": "똑같이 해", "context": [{"target": [3, 4], "action": "DEFEND", "location": "LEFT"}], "expect": [{"kind": "ISSUE", "confidence": "MEDIUM", "target": [3, 4], "action": "DEFEND", "location": "LEFT", "context": ["c1"]}]}
