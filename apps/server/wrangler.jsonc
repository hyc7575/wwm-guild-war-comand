{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winds-command",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "dev": { "port": 8787 },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }]
}
